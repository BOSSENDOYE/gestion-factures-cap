{
  "name": "gestion-factures",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "jest": "^30.5.2",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "watch-comptable-ui": "cds watch --open comptableui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy gestion-factures --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-gestion-factures": "cds watch --open gestionfactures/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-factures-ui": "cds watch --open facturesui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-responsable-ui": "cds watch --open responsableui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/comptable-ui",
    "app/gestion-factures",
    "app/factures-ui",
    "app/responsable-ui"
  ]
}
